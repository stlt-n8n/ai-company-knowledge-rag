      "id": "937f1eae-bb5b-4eca-b614-7b5d56d47922",
      "name": "Prepare Vacation Policy"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b7185341-a209-4d38-82c9-058f649bf8dc",
              "name": "document_text",
              "value": "Company Remote Work Policy  Employees may work remotely up to two days per week.  Remote work days must be coordinated with the employee's manager.  Employees must remain reachable during normal business hours and attend required meetings.  Confidential company information must only be accessed using approved company devices and secure connections.  Remote work may be temporarily restricted when on-site presence is required for business operations.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        208,
        304
      ],
      "id": "28253ac6-82d3-4a61-90ee-d816dfd83088",
      "name": "Prepare Remote Work Policy"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b7185341-a209-4d38-82c9-058f649bf8dc",
              "name": "document_text",
              "value": "Company IT Support Policy  Employees should report technical issues through the internal IT support channel.  Critical issues that prevent employees from working should be marked as high priority.  Employees must not install unauthorized software on company devices.  Passwords must never be shared with colleagues or external parties.  Lost or stolen company devices must be reported to IT immediately.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        208,
        480
      ],
      "id": "82fd0a34-2243-49fc-8c60-dcea2ec765ee",
      "name": "Prepare IT Support Policy"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b7185341-a209-4d38-82c9-058f649bf8dc",
              "name": "document_text",
              "value": "Company Expense Policy  Business expenses must be submitted within 30 days of the purchase.  Receipts are required for expenses above 25 EUR.  Travel and accommodation expenses require manager approval before booking.  Personal expenses are not reimbursable.  Approved expenses are normally reimbursed with the next payroll cycle.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        208,
        656
      ],
      "id": "2b0303b4-74fc-4104-a603-5be5fb1e4ef9",
      "name": "Prepare Expense Policy "
    },
    {
