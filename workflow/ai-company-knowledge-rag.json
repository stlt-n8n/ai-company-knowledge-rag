              "id": "b7185341-a209-4d38-82c9-058f649bf8dc",
              "name": "document_text",
              "value": "Company Vacation Policy  Employees receive 30 paid vacation days per calendar year.  Vacation requests should be submitted at least 14 days in advance.  Managers approve vacation requests based on team availability.  Unused vacation days may be carried over until March 31 of the following year.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
