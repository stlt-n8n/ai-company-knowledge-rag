          "assignments": [
            {
              "id": "b7185341-a209-4d38-82c9-058f649bf8dc",
              "name": "document_text",
              "value": "Company Employee Onboarding Guide  New employees receive access to their company email, communication tools, and required internal systems on their first working day.  The employee's manager is responsible for introducing the team and explaining the employee's responsibilities.  Mandatory security and data protection training must be completed during the first week.  New employees should contact IT support if they experience account or device access problems.  A review meeting with the manager is scheduled after the first 30 days.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
